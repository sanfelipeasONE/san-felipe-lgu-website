# ==============================================================================
# Municipal Government of San Felipe, Zambales - Digital Portal
# Environment Configuration Template
# ==============================================================================

# Application Base URL
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local Docker development default connects to port 5435
POSTGRES_USER="sfz_portal_user"
POSTGRES_PASSWORD="sfz_portal_dev_pass_2026"
POSTGRES_DB="sfz_portal_db"
POSTGRES_PORT=5435

DATABASE_URL="postgresql://sfz_portal_user:sfz_portal_dev_pass_2026@localhost:5435/sfz_portal_db?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Session Security (Phase 2+)
# ------------------------------------------------------------------------------
# Cryptographically strong secret for signing session cookies / JWTs (min 32 bytes)
# Generate via: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (Phase 2+)
# ------------------------------------------------------------------------------
# MinIO, AWS S3, Cloudflare R2, or DigitalOcean Spaces
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="sfz-portal-assets"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/sfz-portal-assets"

# ------------------------------------------------------------------------------
# Initial Super Administrator Seed (Local / Production Setup)
# ------------------------------------------------------------------------------
SEED_SUPERADMIN_NAME="LGU System Administrator"
SEED_SUPERADMIN_EMAIL="admin@example.gov.ph"
SEED_SUPERADMIN_PASSWORD="CHANGE_ME"

# ------------------------------------------------------------------------------
# Cloudinary Storage Configuration (Phase 12+)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"
