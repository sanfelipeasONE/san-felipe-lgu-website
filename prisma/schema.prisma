// Prisma schema for San Felipe LGU Digital Portal & Multi-Office CMS
// Phase 1: Core Identity, Office, and RBAC Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OfficeStatus {
  ACTIVE
  INACTIVE
}

/// Municipal Office entity representing LGU departments/offices.
model Office {
  id          String       @id @default(cuid())
  name        String       // e.g. "Municipal Health Office"
  shortName   String?      // e.g. "MHO"
  slug        String       @unique // e.g. "municipal-health-office" for public URLs
  description String?      @db.Text
  mandate     String?      @db.Text
  officeHead  String?      // Name of department head / OIC
  email       String?
  phone       String?
  location    String?      // Physical location inside Municipal Hall / campus
  officeHours String?      // e.g. "Monday - Friday: 8:00 AM - 5:00 PM"
  status      OfficeStatus @default(ACTIVE)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  newsArticles NewsArticle[]
  servicePages ServicePage[]
  documents   Document[]
  jobOpportunities JobOpportunity[]

  @@index([status])
  @@map("offices")
}

/// User entity for authenticated municipal staff and administrators.
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  // Office affiliation (optional for system-wide administrators)
  officeId     String?
  office       Office?    @relation(fields: [officeId], references: [id], onDelete: SetNull)

  // Role-based access control
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Sessions and audit trail
  sessions     Session[]
  auditLogs    AuditLog[]

  // News & Content authorship
  newsCreated  NewsArticle[] @relation("NewsArticlesCreated")
  newsUpdated  NewsArticle[] @relation("NewsArticlesUpdated")

  // Services Content authorship
  servicePagesCreated ServicePage[] @relation("ServicePagesCreated")
  servicePagesUpdated ServicePage[] @relation("ServicePagesUpdated")

  // Documents & Downloadable Forms authorship (Phase 14)
  documentsCreated Document[] @relation("DocumentsCreated")
  documentsUpdated Document[] @relation("DocumentsUpdated")

  // Job Opportunities authorship (Phase 15)
  jobsCreated JobOpportunity[] @relation("JobsCreated")
  jobsUpdated JobOpportunity[] @relation("JobsUpdated")

  // Tourism Entries authorship (Phase 23)
  tourismCreated TourismEntry[] @relation("TourismCreated")
  tourismUpdated TourismEntry[] @relation("TourismUpdated")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([officeId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum RoleTier {
  SYSTEM_ADMIN
  OFFICE_ADMIN
  STAFF
  CUSTOM
}

/// Role entity for defining system and office authority levels.
model Role {
  id            String           @id @default(cuid())
  name          String           @unique // e.g. "Super Administrator"
  slug          String           @unique // e.g. "super-admin"
  description   String?
  isSystemScope Boolean          @default(false) // If true, role operates across all municipal offices
  tier          RoleTier         @default(CUSTOM)
  isBuiltIn     Boolean          @default(false) // Immutable built-in system role

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  users         User[]
  permissions   RolePermission[]

  @@index([tier])
  @@index([isBuiltIn])
  @@map("roles")
}

/// Granular permission code (e.g. "posts.create", "offices.update").
model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. "posts.create"
  name        String           // Human-readable permission name
  module      String           // Functional area: "users", "offices", "posts", etc.
  description String?

  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Join table linking Roles to their assigned Permissions.
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Server-side session record for authenticated municipal staff.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Security and administrative audit trail.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  officeId  String?
  details   Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([officeId])
  @@index([createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// News & Announcements content entity for municipal publications.
model NewsArticle {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  title                 String
  excerpt               String      @db.Text
  body                  String      @db.Text // Sanitized HTML content from editor
  type                  String      @default("news") // "news" | "announcement" | "advisory" | "notice"
  category              String      @default("GENERAL") // e.g. "PUBLIC SAFETY", "COMMERCE", etc.
  status                NewsStatus  @default(DRAFT)

  // Office affiliation (security boundary)
  officeId              String?
  office                Office?     @relation(fields: [officeId], references: [id], onDelete: Restrict)

  // Authorship tracking
  createdById           String
  createdBy             User        @relation("NewsArticlesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById           String?
  updatedBy             User?       @relation("NewsArticlesUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  // Featured Image metadata (Cloudinary)
  featuredImagePublicId String?
  featuredImageUrl      String?
  featuredImageAlt      String?
  featuredImageWidth    Int?
  featuredImageHeight   Int?
  featuredImageFormat   String?
  featuredImageBytes    Int?

  // Publication & archive lifecycle timestamps
  publishedAt           DateTime?
  archivedAt            DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([officeId])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([status, officeId])
  @@map("news_articles")
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
}

/// Canonical municipal service pages managed via CMS.
model ServicePage {
  id          String        @id @default(cuid())
  serviceKey  String        @unique // "citizens-charter" | "business-permits" | "downloadable-forms" | "job-opportunities"
  title       String
  description String?       @db.Text
  status      ServiceStatus @default(DRAFT)

  // Office affiliation (optional: null indicates municipal-wide / system-level service)
  officeId    String?
  office      Office?       @relation(fields: [officeId], references: [id], onDelete: SetNull)

  // Authorship & audit tracking
  createdById String
  createdBy   User          @relation("ServicePagesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?         @relation("ServicePagesUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  publishedAt DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sections    ServiceSection[]

  // Associated official Document (e.g. Citizen's Charter handbook PDF)
  charterDocumentId String?
  charterDocument   Document?       @relation("ServiceCharterDocument", fields: [charterDocumentId], references: [id], onDelete: SetNull)

  // Associated managed Document (e.g. Business Permits application form or guide)
  attachmentDocumentId String?
  attachmentDocument   Document?    @relation("ServiceAttachmentDocument", fields: [attachmentDocumentId], references: [id], onDelete: SetNull)

  // Featured Image metadata (Cloudinary)
  featuredImagePublicId String?
  featuredImageUrl      String?
  featuredImageAlt      String?
  featuredImageWidth    Int?
  featuredImageHeight   Int?
  featuredImageFormat   String?
  featuredImageBytes    Int?

  @@index([status])
  @@index([officeId])
  @@index([serviceKey])
  @@index([charterDocumentId])
  @@index([attachmentDocumentId])
  @@map("service_pages")
}

/// Ordered content section for a municipal service page.
model ServiceSection {
  id            String      @id @default(cuid())
  servicePageId String
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)

  title         String
  content       String      @db.Text // Sanitized HTML content from rich-text editor
  sortOrder     Int         @default(0)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([servicePageId])
  @@index([servicePageId, sortOrder])
  @@map("service_sections")
}

enum DocumentPurpose {
  DOWNLOADABLE_FORM
  CITIZENS_CHARTER
  JOB_ATTACHMENT
  OTHER_PUBLIC_DOCUMENT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Official downloadable municipal documents and application form templates (Phase 14).
model Document {
  id               String          @id @default(cuid())
  title            String
  description      String?         @db.Text
  category         String?         // e.g. "Business & Licensing", "Civil Registry", "Building & Engineering", "Taxation & Revenue", "Social Services", "General Administration"
  purpose          DocumentPurpose @default(DOWNLOADABLE_FORM)
  status           DocumentStatus  @default(DRAFT)

  // Office ownership: municipal office attribution (optional for committee/statutory documents like BAC)
  officeId         String?
  office           Office?         @relation(fields: [officeId], references: [id], onDelete: Restrict)

  // File metadata (Cloudinary raw storage)
  originalFilename String
  storagePublicId  String
  storageUrl       String
  resourceType     String          @default("raw")
  format           String          // "pdf" | "doc" | "docx" | "xls" | "xlsx"
  mimeType         String          // e.g. "application/pdf"
  bytes            Int             // file size in bytes

  // Authorship & audit tracking
  createdById      String
  createdBy        User            @relation("DocumentsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String?
  updatedBy        User?           @relation("DocumentsUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  // Lifecycle timestamps
  publishedAt      DateTime?
  archivedAt       DateTime?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobOpportunities       JobOpportunity[]
  charterServicePages    ServicePage[]    @relation("ServiceCharterDocument")
  attachmentServicePages ServicePage[]    @relation("ServiceAttachmentDocument")

  @@index([status])
  @@index([officeId])
  @@index([category])
  @@index([purpose])
  @@index([status, purpose])
  @@index([status, publishedAt])
  @@index([status, officeId])
  @@map("documents")
}

enum JobOpportunityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Official municipal job vacancies and career recruitment notices (Phase 15).
model JobOpportunity {
  id                      String               @id @default(cuid())
  title                   String               // Position Title
  slug                    String               @unique
  itemNumber              String?              // Plantilla Item Number (e.g. "MHO-01")
  officeId                String
  office                  Office               @relation(fields: [officeId], references: [id], onDelete: Restrict)
  employmentType          String?              // "Permanent" | "Contractual" | "Casual" | "Co-Terminous"
  salaryGrade             String?              // e.g. "11", "SG 11"
  monthlySalary           String?              // e.g. "₱27,000.00"
  description             String?              @db.Text
  education               String?              @db.Text
  training                String?              @db.Text
  experience              String?              @db.Text
  eligibility             String?              @db.Text
  competency              String?              @db.Text
  applicationInstructions String?              @db.Text
  postingDate             DateTime?
  closingDate             DateTime?
  status                  JobOpportunityStatus @default(DRAFT)

  // Optional attachment reference to an existing Phase 14 official municipal Document
  attachmentDocumentId    String?
  attachmentDocument      Document?            @relation(fields: [attachmentDocumentId], references: [id], onDelete: SetNull)

  // Featured Image metadata (Cloudinary)
  featuredImagePublicId   String?
  featuredImageUrl        String?
  featuredImageAlt        String?
  featuredImageWidth      Int?
  featuredImageHeight     Int?
  featuredImageFormat     String?
  featuredImageBytes      Int?

  // Authorship & audit tracking
  createdById             String
  createdBy               User                 @relation("JobsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById             String?
  updatedBy               User?                @relation("JobsUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  // Lifecycle timestamps
  publishedAt             DateTime?
  archivedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([status])
  @@index([officeId])
  @@index([status, publishedAt])
  @@index([status, closingDate])
  @@map("job_opportunities")
}

enum TourismCategory {
  ATTRACTIONS
  RESORTS
  CULTURE_AND_ARTS
  PRODUCTS
}

enum TourismStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Official municipal tourism entries across attractions, resorts, culture/arts, and local products (Phase 23).
model TourismEntry {
  id                    String          @id @default(cuid())
  category              TourismCategory
  title                 String
  slug                  String          @unique
  summary               String          @db.Text
  body                  String          @db.Text // Sanitized HTML content from rich-text editor

  // Optional visitor and establishment details
  location              String?         // Physical address / Barangay
  mapUrl                String?         // External verified map URL
  contactNumber         String?         // Inquiries phone/mobile
  email                 String?         // Contact email
  websiteUrl            String?         // Website / Link
  operatingHours        String?         // Visiting or business hours

  // Publication lifecycle
  status                TourismStatus   @default(DRAFT)
  publishedAt           DateTime?
  archivedAt            DateTime?

  // Featured Image metadata (Cloudinary)
  featuredImagePublicId String?
  featuredImageUrl      String?
  featuredImageAlt      String?
  featuredImageWidth    Int?
  featuredImageHeight   Int?
  featuredImageFormat   String?
  featuredImageBytes    Int?

  // Authorship & audit tracking
  createdById           String
  createdBy             User            @relation("TourismCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById           String?
  updatedBy             User?           @relation("TourismUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([category])
  @@index([status])
  @@index([status, category])
  @@index([status, publishedAt])
  @@map("tourism_entries")
}

